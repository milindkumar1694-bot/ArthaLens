# ====================================================================
# ARTHALENS — PRODUCTION & RENDER DEPLOYMENT ENVIRONMENT SETUP
# ====================================================================

# Application Settings
APP_NAME=ArthaLens
APP_ENV=production
DEBUG=false
API_PREFIX=/api/v1
CORS_ORIGINS=https://arthalens-frontend.onrender.com,http://localhost:5173

# Data Operational Mode: 'live' (Real data only, no fallback) or 'mock' (Development simulation)
DATA_MODE=live

# --------------------------------------------------------------------
# 1. MARKET DATA / BROKER CREDENTIALS
# --------------------------------------------------------------------
# Select provider: 'angelone' or 'fyers'
BROKER_PROVIDER=angelone

# Angel One SmartAPI Credentials
ANGEL_ONE_API_KEY=your_angel_one_api_key_here
ANGEL_ONE_CLIENT_ID=your_angel_one_client_id_here
ANGEL_ONE_PASSWORD=your_angel_one_password_here
ANGEL_ONE_TOTP=your_angel_one_totp_secret_here # Base32 secret from SmartAPI QR setup (backend generates current 6-digit OTP)
ANGEL_ONE_INSTRUMENT_MASTER_URL=https://margincalculator.angelbroking.com/OpenAPI_File/files/OpenAPIScripMaster.json

# Fyers API Credentials
FYERS_CLIENT_ID=your_fyers_client_id_here
FYERS_SECRET=your_fyers_secret_here
FYERS_ACCESS_TOKEN=your_fyers_access_token_here

# --------------------------------------------------------------------
# 2. DATABASE & HISTORICAL STORAGE CREDENTIALS
# --------------------------------------------------------------------
# PostgreSQL Connection String (Render PostgreSQL Database URL)
DATABASE_URL=postgresql://user:password@hostname:5432/arthalens

# Redis Cache URL (Render Redis Service URL)
REDIS_URL=rediss://default:password@hostname:6379

# Refresh & Cache Expiry TTLs (in seconds)
MARKET_CACHE_TTL_SECONDS=10
OPTION_CHAIN_CACHE_TTL_SECONDS=30
EXPIRY_CACHE_TTL_SECONDS=3600

# --------------------------------------------------------------------
# 3. NEWS DATA CREDENTIALS
# --------------------------------------------------------------------
NEWS_PROVIDER=newsapi
NEWS_API_KEY=your_news_api_key_here

# --------------------------------------------------------------------
# 4. ALERTS & TELEGRAM NOTIFICATION CREDENTIALS
# --------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# --------------------------------------------------------------------
# 5. AI / LLM CREDENTIALS
# --------------------------------------------------------------------
# Select provider: 'xai' or 'openai'
LLM_PROVIDER=xai

# xAI (Grok) Credentials
XAI_API_KEY=your_xai_api_key_here
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.6

# OpenAI Credentials
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
